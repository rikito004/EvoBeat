# Hermes + EvoBeat 环境变量
LLM_PROVIDER=claude
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=sk-...

# OnchainOS 配置（Agent Trade Kit + OnchainOS）
OnchainOS_API_KEY=your_onchainos_key_if_needed

# Audiera 配置
AUDIERA_API_KEY=your-audiera-key

EVOLVE_INTERVAL=4h          # Hermes reflection loop 间隔
MAX_LLM_COST_PER_DAY_USD=30
GAS_BUDGET_BNB=0.02
